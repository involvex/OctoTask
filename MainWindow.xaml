<Window x:Class="OctoTask.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:vm="clr-namespace:OctoTask.UI.ViewModels"
         xmlns:conv="clr-namespace:OctoTask.UI.Converters"
         xmlns:local="clr-namespace:OctoTask"
        mc:Ignorable="d"
        Title="OctoTask"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        MinHeight="400" MinWidth="800"
        FontFamily="Cascadia Mono, Consolas, Courier New">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0d1117"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#161b22"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#30363d"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#c9d1d9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8b949e"/>
        <SolidColorBrush x:Key="TextMuted" Color="#656d76"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#238636"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#388bfd"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#f85149"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#ff7b72"/>

        <!-- Global TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Global Button style: flat dark -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid: dark terminal style -->
        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="{StaticResource BgBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
        </Style>

        <!-- Column header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Row style: terminal look -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161b22"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1f3a5f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cell style -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#1f3a5f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Scrollbar style: thin, dark -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Toolbar button style -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="28"/>
        </Style>

        <!-- Danger button style -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DangerHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Main content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Background="{StaticResource SurfaceBrush}" Margin="0,0,0,1">
            <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding RefreshCommand}"
                    Content="⟳ Refresh"/>
            <Separator Margin="8,0"/>
            <CheckBox x:Name="AutoRefreshToggle"
                      IsChecked="{Binding IsAutoRefreshEnabled}"
                      Content="Auto-refresh (5s)"
                      Foreground="{StaticResource TextSecondary}"
                      Margin="0,0,8,0"/>
            <Separator Margin="8,0"/>
            <Label Content="🔍 Search:"
                   Foreground="{StaticResource TextSecondary}"
                   VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox"
                     Width="200"
                     Height="22"
                     VerticalAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource BgBrush}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="12"
                     Padding="4,2"/>
            <Button x:Name="ClearFilterButton"
                    Command="{Binding ClearFilterCommand}"
                    Content="✕"
                    Width="22" Height="22"
                    VerticalAlignment="Center"
                    ToolTip="Clear search"
                    IsEnabled="{Binding CanClearFilter}"
                    Style="{StaticResource ToolbarButton}"/>
            <Separator Margin="8,0"/>
            <Button x:Name="InstallHookButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding InstallHookCommand}"
                    Content="⚡ Install Hook"/>
            <Button x:Name="UninstallHookButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding UninstallHookCommand}"
                    Content="✕ Remove Hook"/>
            <Button x:Name="RestoreHookButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding RestoreHookCommand}"
                    Content="↺ Restore TM"
                    IsEnabled="{Binding CanRestore}"/>
            <Separator Margin="8,0"/>
            <Button x:Name="KillButton" Style="{StaticResource DangerButton}"
                    Command="{Binding KillProcessCommand}"
                    Content="⏻ Kill Process"
                    IsEnabled="{Binding CanKillProcess}"/>
        </ToolBar>

        <!-- Main content: DataGrid + Details -->
        <DockPanel Grid.Row="1">
            <Border x:Name="DetailsPane"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding ProcessDetails, Converter={x:Static conv:NullToVisibilityConverter.Instance}}"
                    Width="450"
                    DockPanel.Dock="Right">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16">

                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="{Binding SelectedProcess.ProcessName}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding SelectedProcess.Pid, StringFormat='PID {0}'}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,12"/>

                        <!-- Basic Info Section -->
                        <GroupBox Header="Basic Info"
                                  Background="{StaticResource BgBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="12"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ProcessDetails.StartTime, StringFormat='Start Time: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.RunningTime, StringFormat='Running Time: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Priority, StringFormat='Priority: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Session, StringFormat='Session: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.IsResponding, StringFormat='Responding: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Threads, StringFormat='Threads: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Handles, StringFormat='Handles: {0}'}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Process Owner -->
                        <GroupBox Header="Process Owner"
                                  Background="{StaticResource BgBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="12"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ProcessDetails.ProcessOwner, StringFormat='User: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Domain, StringFormat='Domain: {0}'}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Parent Process -->
                        <GroupBox Header="Parent Process"
                                  Background="{StaticResource BgBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="12"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ProcessDetails.ParentProcess, StringFormat='Parent: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.ParentId, StringFormat='Parent PID: {0}'}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- File Info -->
                        <GroupBox Header="File Information"
                                  Background="{StaticResource BgBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="12"
                                  Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ProcessDetails.Description, StringFormat='Description: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Company, StringFormat='Company: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.FileVersion, StringFormat='File Version: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.ProductVersion, StringFormat='Product Version: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.WorkingDirectory, StringFormat='Path: {0}'}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Loaded Modules -->
                        <GroupBox Header="Loaded Modules"
                                  Background="{StaticResource BgBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="12"
                                  Margin="0,0,0,8">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0"
                                          ItemsSource="{Binding ProcessDetails.Modules}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="150"
                                          Background="{StaticResource BgBrush}"
                                          Foreground="{StaticResource TextPrimary}"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          GridLinesVisibility="None"
                                          HeadersVisibility="Column"
                                          RowBackground="{StaticResource BgBrush}"
                                          AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                          CanUserAddRows="False"
                                          CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module Name"
                                                            Binding="{Binding Name}"
                                                            Width="150"/>
                                        <DataGridTextColumn Header="Version"
                                                            Binding="{Binding Version}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="Size"
                                                            Binding="{Binding Size, StringFormat=N0}"
                                                            Width="80"/>
                                        <DataGridTextColumn Header="File"
                                                            Binding="{Binding FileName}"
                                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <!-- Environment Variables -->
                        <GroupBox Header="Environment Variables"
                                  Background="{StaticResource BgBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="12"
                                  Margin="0,0,0,8">
                            <Grid Margin="4">
                                <ListBox ItemsSource="{Binding ProcessDetails.EnvironmentVariables}"
                                         MaxHeight="150"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       ToolTip="{Binding}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DataGrid fills remaining space -->
            <DataGrid x:Name="ProcessDataGrid"
                      Style="{StaticResource DarkDataGrid}"
                      ItemsSource="{Binding Processes}"
                      SelectedItem="{Binding SelectedProcess}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID"
                                        Binding="{Binding Pid}"
                                        SortMemberPath="Pid"
                                        Width="70"/>
                    <DataGridTextColumn Header="Process"
                                        Binding="{Binding ProcessName}"
                                        SortMemberPath="ProcessName"
                                        Width="180"/>
                    <DataGridTextColumn Header="RAM"
                                        Binding="{Binding WorkingSetDisplay}"
                                        SortMemberPath="WorkingSetBytes"
                                        Width="100"/>
                    <DataGridTextColumn Header="CPU"
                                        Binding="{Binding CpuPercentageDisplay}"
                                        SortMemberPath="CpuPercentage"
                                        Width="60"/>
                    <DataGridTextColumn Header="Executable Path"
                                        Binding="{Binding ExecutablePath}"
                                        SortMemberPath="ExecutablePath"
                                        Width="230"/>
                    <DataGridTextColumn Header="Command Line"
                                        Binding="{Binding CommandLine}"
                                        SortMemberPath="CommandLine"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBar Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextSecondary}" BorderThickness="0">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Processes.Count, StringFormat='{}{0} processes'}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}"/>
                </StatusBarItem>
            </StatusBar>
        </Border>
    </Grid>
</Window>
