<Window x:Class="OctoTask.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:vm="clr-namespace:OctoTask.UI.ViewModels"
         xmlns:conv="clr-namespace:OctoTask.UI.Converters"
         xmlns:local="clr-namespace:OctoTask"
        mc:Ignorable="d"
        Title="OctoTask"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        MinHeight="400" MinWidth="800"
        FontFamily="Cascadia Mono, Consolas, Courier New">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityInvertedConverter x:Key="BoolToVisibilityInverted"/>
        <SolidColorBrush x:Key="BgBrush" Color="#0f172a"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1e293b"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#273549"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#f1f5f9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94a3b8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3b82f6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#60a5fa"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10b981"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#f59e0b"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#ef4444"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#f87171"/>

        <!-- Global TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Global Button style: flat dark -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid: modern dark style -->
        <Style x:Key="DarkDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="{StaticResource BgBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

        <!-- Column header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Width="4"
                                   Cursor="SizeWE"
                                   Background="Transparent"/>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Width="4"
                                   Cursor="SizeWE"
                                   Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row style: modern look -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1e3a5f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cell style -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Scrollbar style: thin, dark -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- GroupBox style -->
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="6,6,0,0"
                                    Padding="8,4">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,0,6,6">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar style: modern flat -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>
                            <Border x:Name="PART_Track" Margin="1">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar button style -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="28"/>
        </Style>

        <!-- Toolbar toggle button style -->
        <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="28"/>
        </Style>

        <!-- Danger button style -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DangerHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Dashboard -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Main content -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- System Telemetry Dashboard -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Gauge -->
                <TextBlock Grid.Column="0" Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ProgressBar Grid.Column="1" Value="{Binding SystemCpuUsage}" Maximum="100" Height="16" Background="{StaticResource BgBrush}" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                <!-- RAM Gauge -->
                <TextBlock Grid.Column="2" Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ProgressBar Grid.Column="3" Value="{Binding SystemRamUsage}" Maximum="100" Height="16" Background="{StaticResource BgBrush}" Foreground="{StaticResource SuccessBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                <!-- System Info Text -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                        <Run Text="CPU: "/><Run Text="{Binding SystemCpuUsage, StringFormat='{}{0:F1}%', Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
                        <Run Text="  |  "/>
                        <Run Text="RAM: "/><Run Text="{Binding SystemRamDisplay, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="{StaticResource SurfaceBrush}" Margin="0,0,0,1">
            <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding RefreshCommand}"
                    Content="⟳ Refresh"/>
            <Separator Margin="8,0"/>
            <CheckBox x:Name="AutoRefreshToggle"
                      IsChecked="{Binding IsAutoRefreshEnabled}"
                      Content="Auto-refresh (5s)"
                      Foreground="{StaticResource TextSecondary}"
                      Margin="0,0,8,0"/>
            <Separator Margin="8,0"/>
            <Label Content="🔍 Search:"
                   Foreground="{StaticResource TextSecondary}"
                   VerticalAlignment="Center"/>
             <TextBox x:Name="SearchBox"
                      Width="200"
                      Height="24"
                      VerticalAlignment="Center"
                      Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                      Background="{StaticResource BgBrush}"
                      Foreground="{StaticResource TextPrimary}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      FontFamily="Cascadia Mono, Consolas, Courier New"
                      FontSize="12"
                      Padding="6,2">
                 <TextBox.Resources>
                     <Style TargetType="Border">
                         <Setter Property="CornerRadius" Value="4"/>
                     </Style>
                 </TextBox.Resources>
             </TextBox>
            <Button x:Name="ClearFilterButton"
                    Command="{Binding ClearFilterCommand}"
                    Content="✕"
                    Width="22" Height="22"
                    VerticalAlignment="Center"
                    ToolTip="Clear search"
                    IsEnabled="{Binding CanClearFilter}"
                    Style="{StaticResource ToolbarButton}"/>
            <Separator Margin="8,0"/>
            <Button x:Name="InstallHookButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding InstallHookCommand}"
                    Content="⚡ Install Hook"/>
            <Button x:Name="UninstallHookButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding UninstallHookCommand}"
                    Content="✕ Remove Hook"/>
            <Button x:Name="RestoreHookButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding RestoreHookCommand}"
                    Content="↺ Restore TM"
                    IsEnabled="{Binding CanRestore}"/>
            <Separator Margin="8,0"/>
            <ToggleButton x:Name="TreeViewToggle"
                          IsChecked="{Binding IsTreeView}"
                          Content="🌳 Tree"
                          Style="{StaticResource ToolbarToggleButton}"/>
            <Separator Margin="8,0"/>
            <Button x:Name="SuspendButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding SuspendProcessCommand}"
                    Content="⏸ Suspend"
                    IsEnabled="{Binding CanKillProcess}"/>
            <Button x:Name="ResumeButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding ResumeProcessCommand}"
                    Content="▶ Resume"
                    IsEnabled="{Binding CanKillProcess}"/>
            <Separator Margin="8,0"/>
            <Button x:Name="ExportCsvButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding ExportCsvCommand}"
                    Content="⬇ CSV"/>
            <Button x:Name="ExportJsonButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding ExportJsonCommand}"
                    Content="⬇ JSON"/>
            <Separator Margin="8,0"/>
            <Button x:Name="TraySettingsButton" Style="{StaticResource ToolbarButton}"
                    Command="{Binding OpenTraySettingsCommand}"
                    Content="⚙ Tray"/>
            <Separator Margin="8,0"/>
            <Button x:Name="KillButton" Style="{StaticResource DangerButton}"
                    Command="{Binding KillProcessCommand}"
                    Content="⏻ Kill Process"
                    IsEnabled="{Binding CanKillProcess}"/>
        </ToolBar>

        <!-- Main content: DataGrid + Details -->
        <DockPanel Grid.Row="2">
             <Border x:Name="DetailsPane"
                     Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1,0,0,0"
                     Visibility="{Binding ProcessDetails, Converter={x:Static conv:NullToVisibilityConverter.Instance}}"
                     Width="420"
                     DockPanel.Dock="Right">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16">

                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="{Binding SelectedProcess.ProcessName}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding SelectedProcess.Pid, StringFormat='PID {0}'}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,0,12"/>

                         <!-- Basic Info Section -->
                         <GroupBox Header="Basic Info"
                                   Background="{StaticResource BgBrush}"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ProcessDetails.StartTime, StringFormat='Start Time: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.RunningTime, StringFormat='Running Time: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Priority, StringFormat='Priority: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Session, StringFormat='Session: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.IsResponding, StringFormat='Responding: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Threads, StringFormat='Threads: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Handles, StringFormat='Handles: {0}'}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>

                         <!-- Process Owner -->
                         <GroupBox Header="Process Owner"
                                   Background="{StaticResource BgBrush}"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ProcessDetails.ProcessOwner, StringFormat='User: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Domain, StringFormat='Domain: {0}'}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>

                         <!-- Parent Process -->
                         <GroupBox Header="Parent Process"
                                   Background="{StaticResource BgBrush}"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ProcessDetails.ParentProcess, StringFormat='Parent: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.ParentId, StringFormat='Parent PID: {0}'}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>

                         <!-- File Info -->
                         <GroupBox Header="File Information"
                                   Background="{StaticResource BgBrush}"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ProcessDetails.Description, StringFormat='Description: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.Company, StringFormat='Company: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.FileVersion, StringFormat='File Version: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.ProductVersion, StringFormat='Product Version: {0}'}"
                                           Margin="0,2"/>
                                <TextBlock Text="{Binding ProcessDetails.WorkingDirectory, StringFormat='Path: {0}'}"
                                           Margin="0,2"/>
                            </StackPanel>
                        </GroupBox>

                         <!-- Loaded Modules -->
                         <GroupBox Header="Loaded Modules"
                                   Background="{StaticResource BgBrush}"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0"
                                          ItemsSource="{Binding ProcessDetails.Modules}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="150"
                                          Background="{StaticResource BgBrush}"
                                          Foreground="{StaticResource TextPrimary}"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          GridLinesVisibility="None"
                                          HeadersVisibility="Column"
                                          RowBackground="{StaticResource BgBrush}"
                                          AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                          CanUserAddRows="False"
                                          CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module Name"
                                                            Binding="{Binding Name}"
                                                            Width="150"/>
                                        <DataGridTextColumn Header="Version"
                                                            Binding="{Binding Version}"
                                                            Width="120"/>
                                        <DataGridTextColumn Header="Size"
                                                            Binding="{Binding Size, StringFormat=N0}"
                                                            Width="80"/>
                                        <DataGridTextColumn Header="File"
                                                            Binding="{Binding FileName}"
                                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                         <!-- Environment Variables -->
                         <GroupBox Header="Environment Variables"
                                   Background="{StaticResource BgBrush}"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8">
                            <Grid Margin="4">
                                <ListBox ItemsSource="{Binding ProcessDetails.EnvironmentVariables}"
                                         MaxHeight="150"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       ToolTip="{Binding}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DataGrid / TreeView fills remaining space -->
            <Grid>
                <DataGrid x:Name="ProcessDataGrid"
                          Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          Visibility="{Binding IsTreeView, Converter={StaticResource BoolToVisibilityInverted}}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID"
                                            Binding="{Binding Pid}"
                                            SortMemberPath="Pid"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Process"
                                            Binding="{Binding ProcessName}"
                                            SortMemberPath="ProcessName"
                                            Width="180"/>
                        <DataGridTextColumn Header="RAM"
                                            Binding="{Binding WorkingSetDisplay, Mode=OneWay}"
                                            SortMemberPath="WorkingSetBytes"
                                            Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CPU"
                                            Binding="{Binding CpuPercentageDisplay, Mode=OneWay}"
                                            SortMemberPath="CpuPercentage"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Executable Path"
                                            Binding="{Binding ExecutablePath}"
                                            SortMemberPath="ExecutablePath"
                                            Width="230"/>
                        <DataGridTextColumn Header="Command Line"
                                            Binding="{Binding CommandLine}"
                                            SortMemberPath="CommandLine"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TreeView x:Name="ProcessTreeView"
                          ItemsSource="{Binding ProcessTree}"
                          Visibility="{Binding IsTreeView, Converter={StaticResource BoolToVisibility}}"
                          Background="{StaticResource BgBrush}"
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="0"
                          FontFamily="Cascadia Mono, Consolas, Courier New"
                          FontSize="12">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="1,0"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Pid}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding WorkingSetDisplay, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding CpuPercentageDisplay, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </DockPanel>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBar Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Padding="8,4">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMuted}">
                        <Run Text="{Binding Processes.Count, StringFormat='{}{0} processes', Mode=OneWay}"/>
                        <Run Text="  |  "/>
                        <Run Text="CPU: "/><Run Text="{Binding SystemCpuUsage, StringFormat='{}{0:F1}%', Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
                        <Run Text="  RAM: "/><Run Text="{Binding SystemRamUsage, StringFormat='{}{0:F1}%', Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
                    </TextBlock>
                </StatusBarItem>
            </StatusBar>
        </Border>
    </Grid>
</Window>