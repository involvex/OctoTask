<UserControl x:Class="OctoTask.UI.Views.ResourceGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OctoTask.UI.ViewModels"
             FontFamily="Cascadia Mono, Consolas, Courier New"
             Background="#161b22"
             BorderBrush="#30363d"
             BorderThickness="1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1e293b" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="HeaderToggle"
                              Grid.Column="0"
                              Content="▼ Resources"
                              IsChecked="{Binding IsExpanded}"
                              Foreground="{StaticResource TextSecondary}"
                              FontSize="12"
                              Cursor="Hand"
                              Padding="4,2"
                              HorizontalContentAlignment="Left"
                              Width="140"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Rectangle Width="12" Height="3" Fill="#3b82f6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="12" Height="3" Fill="#10b981" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding CpuDisplay, FallbackValue=CPU: 0%}"
                           Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#0f172a" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
            <Canvas x:Name="GraphCanvas" ClipToBounds="True">
                <Canvas.Background>
                    <SolidColorBrush Color="#0f172a" Opacity="0.5"/>
                </Canvas.Background>
            </Canvas>
        </Border>

        <Border Grid.Row="2" Background="#161b22" Padding="8,4" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="0s" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                <TextBlock Grid.Column="2" Text="-60s" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
